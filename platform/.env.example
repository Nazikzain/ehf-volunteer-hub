# EHF Volunteer Hub configuration. Copy to .env (never commit .env).
# On Hostinger, keep the whole application above public_html and point the web root to public/.
APP_ENV=development            # development | staging | production
APP_URL=http://localhost:8080
APP_BASE_PATH=
APP_TIMEZONE=Europe/London
# 32+ random characters, e.g. php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ehf_volunteer_hub
DB_USER=
DB_PASS=
# DB_SOCKET=/run/mysqld/mysqld.sock

# Audit HMAC keys (32 random bytes, base64): php -r "echo base64_encode(random_bytes(32));"
# Keep an offline escrow copy (Design §6.5, D-27). Never commit real keys.
AUDIT_ACTIVE_KEY_ID=1
AUDIT_KEY_1=

SESSION_SECURE=true            # set false only for local http development

MAIL_TRANSPORT=log             # log (development only) | smtp | disabled
MAIL_FROM=
MAIL_FROM_NAME=EHF Volunteer Hub
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls                # tls (STARTTLS) | ssl
SMTP_USER=
SMTP_PASS=
